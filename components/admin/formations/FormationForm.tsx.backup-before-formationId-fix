function formatFileSize(
  bytes: number,
) {
  if (!Number.isFinite(bytes) || bytes <= 0) {
    return "0 octet";
  }

  if (bytes < 1024) {
    return `${bytes} octets`;
  }

  const kilobytes =
    bytes / 1024;

  if (kilobytes < 1024) {
    return `${kilobytes.toFixed(
      1,
    )} Ko`;
  }

  const megabytes =
    kilobytes / 1024;

  return `${megabytes.toFixed(
    1,
  )} Mo`;
}

function getPrivateFileTypeLabel(
  type: PrivateCourseFileType,
) {
  switch (type) {
    case "PDF":
      return "Document PDF";

    case "WORD":
      return "Document Word";

    case "ZIP":
      return "Archive ZIP";

    default:
      return "Fichier";
  }
}

function createSelectedFileKey(
  file: File,
) {
  return [
    file.name,
    file.size,
    file.lastModified,
    file.type,
  ].join("::");
}

function validatePrivateFile(
  file: File,
):
  | {
      ok: true;
      type: PrivateCourseFileType;
    }
  | {
      ok: false;
      message: string;
    } {
  if (!file.name.trim()) {
    return {
      ok: false,
      message:
        "Un fichier sélectionné possède un nom invalide.",
    };
  }

  if (file.size <= 0) {
    return {
      ok: false,
      message: `Le fichier « ${file.name} » est vide.`,
    };
  }

  const type =
    detectPrivateFileType(file);

  if (!type) {
    return {
      ok: false,
      message: `Le fichier « ${file.name} » n’est pas accepté. Formats autorisés : PDF, DOC, DOCX et ZIP.`,
    };
  }

  const maxSize =
    type === "ZIP"
      ? MAX_ZIP_SIZE
      : MAX_DOCUMENT_SIZE;

  if (file.size > maxSize) {
    return {
      ok: false,
      message:
        type === "ZIP"
          ? `Le fichier ZIP « ${file.name} » ne doit pas dépasser 100 Mo.`
          : `Le fichier « ${file.name} » ne doit pas dépasser 25 Mo.`,
    };
  }

  const mimeType =
    file.type.trim().toLowerCase();

  if (
    mimeType &&
    !isAllowedMimeForType(
      type,
      mimeType,
    )
  ) {
    return {
      ok: false,
      message: `Le type du fichier « ${file.name} » ne correspond pas à son format.`,
    };
  }

  return {
    ok: true,
    type,
  };
}

function detectPrivateFileType(
  file: File,
): PrivateCourseFileType | null {
  const lowerName =
    file.name.toLowerCase();

  if (lowerName.endsWith(".pdf")) {
    return "PDF";
  }

  if (
    lowerName.endsWith(".doc") ||
    lowerName.endsWith(".docx")
  ) {
    return "WORD";
  }

  if (lowerName.endsWith(".zip")) {
    return "ZIP";
  }

  return null;
}

function isAllowedMimeForType(
  type: PrivateCourseFileType,
  mimeType: string,
) {
  if (type === "PDF") {
    return (
      mimeType === "application/pdf"
    );
  }

  if (type === "WORD") {
    return (
      mimeType === "application/msword" ||
      mimeType ===
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" ||
      mimeType ===
        "application/octet-stream"
    );
  }

  if (type === "ZIP") {
    return (
      mimeType === "application/zip" ||
      mimeType ===
        "application/x-zip-compressed" ||
      mimeType ===
        "application/octet-stream"
    );
  }

  return false;
}

function normalizeApiPrivateFile(
  value: unknown,
): ApiPrivateCourseFile | null {
  if (
    !value ||
    typeof value !== "object"
  ) {
    return null;
  }

  const record =
    value as Record<string, unknown>;

  const id =
    typeof record.id === "string"
      ? record.id.trim()
      : "";

  const name =
    typeof record.name === "string"
      ? record.name.trim()
      : "";

  const rawType =
    typeof record.type === "string"
      ? record.type.trim().toUpperCase()
      : "";

  const type: PrivateCourseFileType | null =
    rawType === "PDF" ||
    rawType === "WORD" ||
    rawType === "ZIP"
      ? rawType
      : null;

  const size =
    typeof record.size === "number" &&
    Number.isFinite(record.size) &&
    record.size >= 0
      ? record.size
      : 0;

  if (!id || !name || !type) {
    return null;
  }

  return {
    id,
    name,
    type,
    size,
    mimeType:
      typeof record.mimeType === "string"
        ? record.mimeType
        : null,
    position:
      typeof record.position === "number" &&
      Number.isInteger(record.position)
        ? record.position
        : undefined,
    createdAt:
      typeof record.createdAt === "string"
        ? record.createdAt
        : undefined,
    updatedAt:
      typeof record.updatedAt === "string"
        ? record.updatedAt
        : undefined,
  };
}

function getPrivateFilesFromApiResponse(
  data: ApiResponse,
): ApiPrivateCourseFile[] {
  const candidates =
    Array.isArray(data.files)
      ? data.files
      : Array.isArray(data.resources)
        ? data.resources
        : data.file
          ? [data.file]
          : [];

  return candidates
    .map((file) =>
      normalizeApiPrivateFile(file),
    )
    .filter(
      (
        file,
      ): file is ApiPrivateCourseFile =>
        file !== null,
    )
    .sort((a, b) => {
      const aPosition =
        a.position ??
        Number.MAX_SAFE_INTEGER;

      const bPosition =
        b.position ??
        Number.MAX_SAFE_INTEGER;

      return aPosition - bPosition;
    });
}

async function uploadFormationImage(
  formationId: string,
  type: "PRIMARY" | "SECONDARY",
  file: File,
) {
  const formData =
    new FormData();

  formData.append(
    "file",
    file,
    file.name,
  );

  formData.append(
    "type",
    type,
  );

  const response = await fetch(
    `/api/admin/formations/${encodeURIComponent(
      formationId,
    )}/images`,
    {
      method: "POST",
      credentials:
        "same-origin",
      body: formData,
    },
  );

  const data =
    await readApiResponse(response);

  if (
    !response.ok ||
    !data.success
  ) {
    const label =
      type === "PRIMARY"
        ? "l’image principale"
        : "l’image secondaire";

    throw new Error(
      getApiErrorMessage(
        data,
        `Impossible d’enregistrer ${label} de la formation.`,
      ),
    );
  }
}

async function readApiResponse(
  response: Response,
): Promise<ApiResponse> {
  try {
    const contentType =
      response.headers
        .get("content-type")
        ?.toLowerCase() ?? "";

    if (
      !contentType.includes(
        "application/json",
      )
    ) {
      return {};
    }

    return (
      (await response.json()) as
        ApiResponse
    );
  } catch {
    return {};
  }
}

function getApiErrorMessage(
  data: ApiResponse,
  fallback: string,
) {
  if (
    typeof data.message ===
      "string" &&
    data.message.trim()
  ) {
    return data.message.trim();
  }

  if (data.fieldErrors) {
    const firstFieldError =
      Object.values(
        data.fieldErrors,
      ).find(
        (message) =>
          typeof message ===
            "string" &&
          message.trim(),
      );

    if (firstFieldError) {
      return firstFieldError;
    }
  }

  return fallback;
}